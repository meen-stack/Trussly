# Postgres connection string (Neon, Supabase or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trussly"
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=""
# Public URL used in email links
APP_URL="http://localhost:3000"
# Optional: send real emails (otherwise they're logged to the console).
# Option 1, no domain needed: a Gmail address and a Google app password.
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  (defaults; change for another provider)
# Option 2: Resend. Needs a domain verified in Resend to email anyone but yourself.
RESEND_API_KEY=""
# Optional sender, e.g. "Trussly <notifications@yourdomain.com>"
EMAIL_FROM=""
# Optional: store uploads in Vercel Blob (otherwise saved to public/uploads)
BLOB_READ_WRITE_TOKEN=""
# Optional: protects the daily missing-report cron endpoint
CRON_SECRET=""
