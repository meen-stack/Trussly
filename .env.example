# Postgres connection string (Neon, Supabase or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildtrace"
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=""
# Public URL used in email links
APP_URL="http://localhost:3000"
# Optional: send real emails through Resend (otherwise emails are logged to the console)
RESEND_API_KEY=""
EMAIL_FROM="BuildTrace <notifications@example.com>"
# Optional: store uploads in Vercel Blob (otherwise saved to public/uploads)
BLOB_READ_WRITE_TOKEN=""
# Optional: protects the daily missing-report cron endpoint
CRON_SECRET=""
