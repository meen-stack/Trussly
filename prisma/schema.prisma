generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  SUPERVISOR
  CONTRACTOR
  FINANCE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

/// Work verification track. Independent of the invoice and payment track.
enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED // contractor submitted evidence, waiting for the site supervisor
  INSPECTED // supervisor passed it, waiting for the project manager
  AWAITING_OWNER // manager approved, value is over the owner's limit
  CORRECTIONS // sent back to the contractor to fix and resubmit
  VERIFIED
  REJECTED // closed without being accepted
}

enum ReportStatus {
  SUBMITTED
  ACCEPTED
  RETURNED
}

/// Invoice and payment track. "No invoice", "Partially paid" and "Overdue" are worked out from the data.
enum ExpenseStatus {
  SUBMITTED
  OWNER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  PAYMENT_REJECTED
}

model Company {
  id                String    @id @default(cuid())
  name              String
  currency          String    @default("USD")
  approvalThreshold Int       @default(1000000) // cents; spend above this needs owner approval
  retentionPercent  Int       @default(5) // held back from contractor invoices until handover
  paymentTermsDays  Int       @default(30)
  createdAt         DateTime  @default(now())
  users             User[]
  projects          Project[]
  invites           Invite[]
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          Role
  title         String?
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  memberships   ProjectMember[]
  reports       DailyReport[]   @relation("ReportAuthor")
  expenses      Expense[]       @relation("ExpenseSubmitter")
  assignedWork  Milestone[]     @relation("WorkAssignee")
  payments      Payment[]
  notifications Notification[]
  auditEvents   AuditEvent[]
  resetTokens   PasswordReset[]
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      Role
  token     String    @unique
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

model Project {
  id          String          @id @default(cuid())
  name        String
  location    String
  description String?
  coverUrl    String?
  status      ProjectStatus   @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
  budgetLines BudgetLine[]
  milestones  Milestone[]
  reports     DailyReport[]
  auditEvents AuditEvent[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model BudgetLine {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String
  budgeted  Int // cents
  expenses  Expense[]
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime
  paymentAmount Int             @default(0) // cents, the value of this work
  status        MilestoneStatus @default(NOT_STARTED)
  sortOrder     Int             @default(0)
  assigneeId    String?
  assignee      User?           @relation("WorkAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  submittedNote String?
  inspectNote   String?
  reviewNote    String?
  startedAt     DateTime?
  submittedAt   DateTime?
  inspectedAt   DateTime?
  approvedAt    DateTime?
  verifiedAt    DateTime?
  photos        Photo[]
  invoices      Expense[]
}

model DailyReport {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation("ReportAuthor", fields: [authorId], references: [id])
  date       DateTime     @db.Date
  weather    String
  crewCount  Int
  progress   Int          @default(0) // percent of overall work complete, as estimated on site
  workDone   String
  issues     String? // challenges encountered
  materials  String? // materials received
  equipment  String? // equipment used
  incidents  String? // safety incidents
  remarks    String? // supervisor remarks
  status     ReportStatus @default(SUBMITTED)
  reviewNote String?
  createdAt  DateTime     @default(now())
  photos     Photo[]

  @@unique([projectId, date])
}

model Photo {
  id          String       @id @default(cuid())
  url         String
  caption     String?
  lat         Float?
  lng         Float?
  takenAt     DateTime     @default(now())
  reportId    String?
  report      DailyReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model Expense {
  id           String        @id @default(cuid())
  budgetLineId String
  budgetLine   BudgetLine    @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  submitterId  String
  submitter    User          @relation("ExpenseSubmitter", fields: [submitterId], references: [id])
  vendor       String
  description  String
  milestoneId  String?
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  amount       Int // cents
  retention    Int           @default(0) // cents held back until handover
  invoiceUrl   String?
  status       ExpenseStatus @default(SUBMITTED)
  reviewNote   String?
  dueDate      DateTime?
  createdAt    DateTime      @default(now())
  decidedAt    DateTime?
  payments     Payment[]
}

model Payment {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount       Int // cents
  reference    String?
  paidAt       DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}
